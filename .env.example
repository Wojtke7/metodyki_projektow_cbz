# Copy this file to .env and fill in real values. Never commit .env.
# These variables are placeholders; the team will adjust them when implementation starts.

# Google AI Studio API key (backend only, never exposed to the frontend)
GEMINI_API_KEY=

# Gemini model identifier (optional, defaults to models/gemini-flash-lite-latest)
GEMINI_MODEL=models/gemini-flash-lite-latest

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/prostefakty

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0
